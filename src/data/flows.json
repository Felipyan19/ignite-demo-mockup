      },
      {
        "id": "choosePdf",
        "options": [
          {
            "id": "generatePdf",
            "label": "Generar PDF",
            "userText": "Sí, generar cotización formal",
            "sequence": [
              { "type": "message", "kind": "quote-document", "delay": 700, "documentName": "Cotización-COT-1048.pdf", "documentTotal": "{{paymentTerm.total}}" },
              { "type": "progress", "step": 2, "complete": false, "title": "PDF generado", "detail": "Cotización formal enviada por WhatsApp", "tool": "quote" },
              { "type": "goto", "step": "confirmOrder" }
