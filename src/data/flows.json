              { "type": "message", "kind": "text", "delay": 760, "text": "Esta es tu cotización:\n\nAcetaminofén 500 mg · 100 unidades\nValor total: {{paymentTerm.total}}\n\n¿Deseas recibir la cotización formal en PDF?" },
              { "type": "progress", "step": 2, "complete": false, "title": "Cotización presentada", "detail": "100 unidades · total {{paymentTerm.total}}", "tool": "quote" },
              { "type": "goto", "step": "choosePdf" }
            ]
          }
