              { "type": "complete", "result": "order", "fields": { "id": "ORD-4041", "customer": "{{customerName}}", "product": "Acetaminofén 500 mg", "quantity": "100 unidades", "total": "{{paymentTerm.total}}", "term": "{{paymentTerm.termLabel}}", "isNew": true } }
